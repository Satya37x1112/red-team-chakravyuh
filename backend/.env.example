# --- Database ---
# Postgres: postgresql+psycopg2://<user>:<password>@localhost:5432/chakravyuh
DATABASE_URL=sqlite:///./dev.db

# --- Telemetry source ---
# "local"  -> collector runs on the Windows target itself (psutil + pywin32)
# "winrm"  -> collector polls a remote Windows target over WinRM (pywinrm)
# "none"   -> no source wired yet; the collector reports "unavailable", never fake values
TELEMETRY_SOURCE=none

# WinRM connection (only used when TELEMETRY_SOURCE=winrm). Lab host-only IP.
WINRM_ENDPOINT=192.168.56.20
WINRM_PORT=5985
WINRM_USER=labadmin
WINRM_PASSWORD=
WINRM_TRANSPORT=ntlm

# How often to poll the target, in seconds.
POLL_INTERVAL=5

# --- AI decision engine (via OpenRouter, OpenAI-compatible endpoint) ---
# Leave OPENROUTER_API_KEY empty to disable the LLM call; the engine then returns
# a clearly-labelled "llm_unavailable" decision instead of inventing one.
OPENROUTER_API_KEY=
# Optional: one key per module to spread free-tier request quota.
# Each falls back to OPENROUTER_API_KEY above when left blank.
OPENROUTER_API_KEY_DDOS=
OPENROUTER_API_KEY_BRUTEFORCE=
OPENROUTER_API_KEY_RATUBA=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Tried in order if the primary model fails (e.g. 402 out of credits). Empty disables.
OPENROUTER_FALLBACK_MODELS=openrouter/free

# --- Lab-tool integration (optional; for the operator-implemented execute() adapters) ---
# All blank by default. Fill in only when wiring your own authorized lab adapters.
HYDRA_WORDLIST_DIR=
LOCUST_FILE_PATH=
CALDERA_URL=
CALDERA_API_KEY=

# --- External tool integrations (see /api/integrations; all optional) ---
# CALDERA report analyzer. Folder of Caldera operation *report*.json files to
# offer as samples in the UI. Blank -> the vendored caldera-ai-project samples.
# The AI SOC narrative reuses OPENROUTER_API_KEY above (never Groq).
CALDERA_REPORT_DIR=

# Locust load-test driver (the real DDoS path). Fail-closed: it will not run
# until LOCUST_ENABLED=true AND LOCUST_FILE_PATH (an operator-authored
# locustfile) AND LOCUST_TARGET_URL (an authorized lab host) are all set.
# Requests can lower these caps but never exceed them.
LOCUST_ENABLED=false
LOCUST_TARGET_URL=
LOCUST_MAX_USERS=50
LOCUST_MAX_SPAWN_RATE=10
LOCUST_MAX_RUN_SECONDS=120

# THC-Hydra login cracker (the real credential-test path behind the BruteForce
# module). Fail-closed, just like Locust: it will not run until HYDRA_ENABLED=true
# AND HYDRA_TARGET (an authorized lab host) AND HYDRA_USERLIST_PATH AND
# HYDRA_PASSLIST_PATH (operator-provided wordlists) are all set. Even then it only
# runs that one list pair against that one target+service, with users×passwords,
# parallel tasks, and run time hard-capped below. Requests can lower the caps,
# never exceed them. Authorized lab targets only.
HYDRA_BIN=hydra
HYDRA_ENABLED=false
HYDRA_TARGET=
HYDRA_SERVICE=ssh
HYDRA_USERLIST_PATH=
HYDRA_PASSLIST_PATH=
HYDRA_MAX_TASKS=4
HYDRA_MAX_ATTEMPTS=500
HYDRA_MAX_RUN_SECONDS=120

# vervet signed-emulation CLI: path to the built binary (or a name on PATH).
# Build it with: cargo build --release -p vervet-cli
VERVET_BIN=vervet

# PentestGPT agent console script (from its pyproject) or a full path.
PENTESTGPT_CMD=pentestgpt-agent
